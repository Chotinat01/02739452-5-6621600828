# Run scripts/setup.ps1 to generate local credentials. Never commit .env.
POSTGRES_USER=recipe_admin
POSTGRES_PASSWORD=GENERATE_WITH_SETUP
POSTGRES_DB=airflow
PIPELINE_DATABASE_URL=postgresql://recipe_admin:GENERATE_WITH_SETUP@postgres:5432/airflow
DASHBOARD_DATABASE_URL=postgresql://recipe_reader:GENERATE_WITH_SETUP@postgres:5432/airflow
DASHBOARD_PASSWORD=GENERATE_WITH_SETUP
AIRFLOW_ADMIN_USER=student
AIRFLOW_ADMIN_PASSWORD=GENERATE_WITH_SETUP
AIRFLOW_FERNET_KEY=GENERATE_WITH_SETUP
AIRFLOW_SECRET_KEY=GENERATE_WITH_SETUP
AIRFLOW_PORT=8080
DASHBOARD_PORT=8501
